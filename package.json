{
  "name": "dsh-key-managment",
  "version": "1.0.2",
  "type": "module",
  "description": "Per-provider API key pool with manual switching for DSH providers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhYi8/dsh-key-managment.git"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 core.test.mjs quota.test.mjs index.test.mjs timer.test.mjs"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "core.test.mjs",
    "quota.test.mjs",
    "index.test.mjs",
    "timer.test.mjs",
    "quota-bridge.js",
    "quota/**/*.js",
    "quota/NOTICE.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
